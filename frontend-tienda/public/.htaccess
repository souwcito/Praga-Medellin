# =============================================================================
# .htaccess raíz — pragamedellin.com (public_html)
# Estructura:
#   /                -> tienda (este SPA)
#   /panel/          -> panel admin (tiene su propio .htaccess)
#   /api/*           -> Laravel (public_html/api-app/public/index.php)
#   /images/*        -> imágenes de productos (public_html/api-app/public/images)
# =============================================================================

# ---------- www -> dominio principal ----------
# Un solo origen evita CORS, enlaces compartidos con www y contenido duplicado.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{REQUEST_URI} !^/\.well-known/
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]
</IfModule>

# ---------- HTTPS forzado ----------
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} !=on
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

# ---------- API Laravel ----------
<IfModule mod_rewrite.c>
  RewriteEngine On
  # /api/* -> front controller de Laravel (las rutas ya viven bajo /api)
  RewriteCond %{REQUEST_URI} ^/api(/|$)
  RewriteRule ^api/(.*)$ api-app/public/index.php [QSA,L]
  # /images/* -> archivos estáticos subidos por el panel
  RewriteCond %{REQUEST_URI} ^/images(/|$)
  RewriteRule ^images/(.*)$ api-app/public/images/$1 [L]
</IfModule>

# ---------- Cache-busting de navegación HTML ----------
# Fuerza una URL nueva (?v=BUILD) en cada deploy para que celulares y
# navegadores con caché vieja no sigan mostrando el index.html anterior.
# No toca API, imágenes, panel, assets ni archivos estáticos.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{REQUEST_URI} !^/api(/|$)
  RewriteCond %{REQUEST_URI} !^/api-app(/|$)
  RewriteCond %{REQUEST_URI} !^/images(/|$)
  RewriteCond %{REQUEST_URI} !^/panel(/|$)
  RewriteCond %{REQUEST_URI} !^/assets(/|$)
  RewriteCond %{REQUEST_URI} !^/\.well-known(/|$)
  RewriteCond %{REQUEST_URI} !\.(css|js|mjs|json|xml|txt|png|jpe?g|gif|webp|svg|ico|woff2?|ttf|eot|webmanifest)$ [NC]
  RewriteCond %{QUERY_STRING} !(^|&)v=
  RewriteRule ^(.*)$ /$1?v=__BUILD_VERSION__ [R=302,L,QSA,E=NO_CACHE_VERSION:1]
</IfModule>

<IfModule mod_headers.c>
  Header always set Cache-Control "no-store, no-cache, must-revalidate, max-age=0" env=NO_CACHE_VERSION
  Header always set X-LiteSpeed-Cache-Control "no-cache" env=NO_CACHE_VERSION
  Header always set X-Hcdn-Cache-Control "no-cache" env=NO_CACHE_VERSION
</IfModule>

# ---------- SPA fallback (tienda) — excluye api, images y panel ----------
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{REQUEST_URI} !^/api(/|$)
  RewriteCond %{REQUEST_URI} !^/images(/|$)
  RewriteCond %{REQUEST_URI} !^/panel(/|$)
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>

# ---------- Caché de navegador para estáticos ----------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType application/x-javascript "access plus 1 year"
  ExpiresByType image/gif "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType application/json "access plus 0 seconds"
</IfModule>

# ---------- API y panel: NUNCA cachear (evita 404/estados viejos en el CDN) ----------
<IfModule mod_setenvif.c>
  SetEnvIf Request_URI "^/api/" NO_CACHE=1
  SetEnvIf Request_URI "^/panel/" NO_CACHE=1
</IfModule>
<IfModule mod_headers.c>
  Header always set Cache-Control "no-store, no-cache, must-revalidate, max-age=0" env=NO_CACHE
  Header always set X-LiteSpeed-Cache-Control "no-cache" env=NO_CACHE
  Header always set X-Hcdn-Cache-Control "no-cache" env=NO_CACHE
  Header always unset Expires env=NO_CACHE
</IfModule>

# ---------- Cabeceras de caché ----------
<IfModule mod_headers.c>
  <FilesMatch "\.(css|js|mjs|woff2|woff|ttf|eot|png|jpg|jpeg|gif|webp|svg|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.html$">
    # El HTML NO se cachea: así todos los usuarios reciben el index.html del
    # último deploy y cargan los assets nuevos (que tienen hash propio).
    Header set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
    Header set X-LiteSpeed-Cache-Control "no-cache"
    Header set X-Hcdn-Cache-Control "no-cache"
  </FilesMatch>
  <FilesMatch "\.json$">
    Header set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
    Header set X-LiteSpeed-Cache-Control "no-cache"
    Header set X-Hcdn-Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

# ---------- Compresión gzip ----------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml
  AddOutputFilterByType DEFLATE application/javascript application/x-javascript
  AddOutputFilterByType DEFLATE application/json application/xml
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# ---------- Seguridad básica ----------
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>